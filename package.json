{
  "name": "mais-habito-api",
  "version": "1.0.0",
  "description": "Backend API - Node.js + TypeScript + PostgreSQL",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "knex --knexfile dist/database/knexfile.js migrate:latest",
    "migrate:dev": "ts-node ./node_modules/knex/bin/cli.js --knexfile src/database/knexfile.ts migrate:latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafaeltiMoreira/mais-habito-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/RafaeltiMoreira/mais-habito-api/issues"
  },
  "homepage": "https://github.com/RafaeltiMoreira/mais-habito-api#readme",
  "devDependencies": {
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/knex": "^0.15.2",
    "@types/node": "^25.0.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "node-cron": "^4.2.1",
    "pg": "^8.17.2",
    "typescript": "^5.9.3"
  }
}
